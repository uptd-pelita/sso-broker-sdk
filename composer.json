{
    "name": "uptd-pelita/sso-broker-sdk",
    "description": "SSO Broker SDK for Bali Province Applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "I Wayan Aditya Wiguna",
            "email": "adityawiguna@baliprov.go.id"
        },
        {
            "name": "I Kadek Wahyu Sudiatmika",
            "email": "wahyu.sudiatmika@baliprov.go.id"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "guzzlehttp/guzzle": "^6.0|^7.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Baliprov\\SSOBroker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Baliprov\\SSOBroker\\SSOBrokerServiceProvider"
            ],
            "aliases": {
                "SSOBroker": "Baliprov\\SSOBroker\\Facades\\SSOBroker"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
